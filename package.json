{
  "name": "gaiatrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/serve.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/serve.mjs",
    "data": "node scripts/fetch-data.mjs",
    "data:eco": "node scripts/fetch-ecological.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/validate-deploy.mjs",
    "deploy": "vercel",
    "deploy:prod": "vercel --prod",
    "data:refresh": "node scripts/fetch-data.mjs --refresh"
  },
  "engines": {
    "node": "26.x"
  }
}
